# Takaro WebSocket URL (from your Takaro instance)
TAKARO_WS_URL=wss://connect.takaro.io/

# Registration token (from the Takaro dashboard)
TAKARO_REGISTRATION_TOKEN=your-registration-token

# Enable debug logging (shows raw WebSocket messages in docker compose logs)
# TAKARO_DEBUG=true

# Takaro MCP Server (for agent access to Takaro API)
TAKARO_USERNAME=your-email@example.com
TAKARO_PASSWORD=your-password
TAKARO_DOMAIN_ID=your-domain-uuid
TAKARO_HOST=https://api.next.takaro.dev
